<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#101522" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="LIVEIMAGE" android:textColor="#FFFFFF" android:textSize="22sp"
        android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Escolha uma imagem e ajuste no quadro de prévia." android:textColor="#B9C4D8"
        android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <FrameLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="14dp" android:background="#263247">
        <TextView android:id="@+id/hint" android:text="Prévia 9:16\nToque em escolher imagem"
            android:textColor="#DCE5F5" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <ImageView android:id="@+id/image" android:layout_width="120dp" android:layout_height="120dp"
            android:layout_gravity="top|start" android:scaleType="fitCenter" android:visibility="gone"/>
    </FrameLayout>
    <Button android:id="@+id/choose" android:text="Escolher imagem" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/remove" android:text="Remover fundo (pessoas)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Tamanho da imagem" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <SeekBar android:id="@+id/size" android:max="240" android:progress="72" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/start" android:text="Ativar sobreposição" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/stop" android:text="Remover da tela" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="A captura da sobreposição pelo TikTok depende do modo de LIVE utilizado."
        android:textColor="#9EABC1" android:textSize="12sp" android:layout_marginTop="4dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>