<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="12dp"
    android:background="#101522" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/preview" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginEnd="12dp" android:background="#263247">
        <TextView android:id="@+id/hint" android:text="PRÉVIA\nEscolha uma imagem"
            android:textColor="#DCE5F5" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <ImageView android:id="@+id/image" android:layout_width="120dp" android:layout_height="120dp"
            android:layout_gravity="top|start" android:scaleType="fitCenter" android:visibility="gone"/>
    </FrameLayout>
    <ScrollView android:layout_width="280dp" android:layout_height="match_parent" android:fillViewport="true">
      <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="LIVEIMAGE" android:textColor="#FFFFFF" android:textSize="22sp"
            android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/choose" android:text="Escolher imagem" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/remove" android:text="Selecionar cor para remover" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Intensidade do chroma key" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/strength" android:max="200" android:progress="70" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/rotate" android:text="Girar 90°" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Tamanho da imagem" android:textColor="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/size" android:max="600" android:progress="72" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/start" android:text="Ativar sobreposição" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/stop" android:text="Remover da tela" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="A captura da sobreposição pelo TikTok depende do modo de LIVE utilizado."
            android:textColor="#9EABC1" android:textSize="12sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
      </LinearLayout>
    </ScrollView>
</LinearLayout>